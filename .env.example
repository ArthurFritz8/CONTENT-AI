# ===== IA =====
GEMINI_API_KEY=

# ===== Pesquisa web (Tavily Researcher, 1.000 créditos/mês) =====
TAVILY_API_KEY=

# ===== Descoberta de produtos (candidatos; nunca confirma afiliação) =====
SOCIALCRAWL_API_KEY=
TRENDS_MCP_API_KEY=

# ===== Pexels (stock de imagens, free 200 req/hora) =====
PEXELS_API_KEY=

# ===== Supabase =====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=

# ===== YouTube Data API v3 (OAuth) =====
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# ===== Telegram (gate de aprovação humana) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=
TELEGRAM_WEBHOOK_SECRET=

# ===== TikTok Shop Partner API (conector arquivado; não é necessário para o afiliado no app) =====
# Preencher somente se uma integração oficial for aprovada. Nunca enviar ao Gemini, Telegram ou frontend.
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_CREATOR_ACCESS_TOKEN=

# ===== Renderer local =====
LOCAL_RENDERER_PORT=3456
PIPER_MODEL_PATH=./models/pt-BR-female.onnx

# ===== GitHub Actions (trigger de render remoto via workflow_dispatch) =====
GITHUB_TOKEN=
GITHUB_REPO=ArthurFritz8/CONTENT-AI
GITHUB_BRANCH=main

# ===== Budget guard (defaults conservadores; runtime lê de system_config, isto é fallback) =====
BUDGET_CEILING=50
TTS_PREFERRED_ENGINE=gemini

# ===== Opcional (NAO necessário para o MVP) =====
OPENROUTER_API_KEY=

# ===== Deploy =====
STORAGE_BUCKET=assets
SUPABASE_CLI_VERSION=latest
CONFIGURE_GITHUB_ACTIONS_SECRETS=1
